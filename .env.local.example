# ─────────────────────────────────────────────────────────────
# Booking OS — Variables d'environnement
# Copier ce fichier en `.env.local` puis remplir les valeurs.
# `.env.local` est ignoré par git (ne jamais committer de secrets).
# ─────────────────────────────────────────────────────────────

# ── Supabase (étape 0.2) ─────────────────────────────────────
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_...) — recommandée pour le front (rotation indépendante).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé `service_role`/secret : serveur UNIQUEMENT, ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth — Gmail + Calendar (étapes 5.x / 6.x) ───────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Resend — fallback email sortant (étape 5.3) ──────────────
RESEND_API_KEY=

# ── Sentry — error tracking (configuré ultérieurement) ───────
NEXT_PUBLIC_SENTRY_DSN=

# ── App ──────────────────────────────────────────────────────
# URL publique de l'app (http://localhost:3000 en local).
NEXT_PUBLIC_APP_URL=http://localhost:3000
