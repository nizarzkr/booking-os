# ─────────────────────────────────────────────────────────────
# Booking OS — Variables d'environnement
# Copier ce fichier en `.env.local` puis remplir les valeurs.
# `.env.local` est ignoré par git (ne jamais committer de secrets).
# ─────────────────────────────────────────────────────────────

# ── Supabase (étape 0.2) ─────────────────────────────────────
# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# Clé publiable (sb_publishable_...) — recommandée pour le front (rotation indépendante).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé `service_role`/secret : serveur UNIQUEMENT, ne jamais exposer côté client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Google OAuth — Gmail + Calendar (étapes 5.x / 6.x) ───────
# console.cloud.google.com > API Gmail activée > ID client OAuth (App Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# DOIT correspondre EXACTEMENT à l'URI enregistrée dans Google Cloud.
# En dev : http://localhost:3000/api/gmail/callback
GOOGLE_REDIRECT_URI=

# ── Resend — fallback email sortant (étape 5.3) ──────────────
RESEND_API_KEY=

# ── Sentry — error tracking (configuré ultérieurement) ───────
NEXT_PUBLIC_SENTRY_DSN=

# ── App ──────────────────────────────────────────────────────
# URL publique de l'app (http://localhost:3000 en local).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cron — récupération inbound Gmail (étape 5.4) ────────────
# Secret protégeant GET /api/gmail/sync (appelé par un Vercel Cron).
# Généré au hasard, ex. `openssl rand -hex 32`. Sans lui, la route est 503.
CRON_SECRET=

# ── Email IMAP/SMTP — connexion des boîtes hors-Google ───────
# Clé de chiffrement des mots de passe d'application (AES-256-GCM).
# 32 octets, en base64 ou hex. Générer avec : `openssl rand -base64 32`.
# Sans elle, la connexion d'une adresse IMAP/SMTP est désactivée.
EMAIL_ENCRYPTION_KEY=
